{
  "name": "@wicky/types",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs');for(const f of['dist','tsconfig.tsbuildinfo'])try{fs.rmSync(f,{recursive:true,force:true})}catch{}\"",
    "lint": "echo 'ok'"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
